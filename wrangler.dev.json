{
  "name": "promptbanken-dev",
  "compatibility_date": "2026-09-06",
  "main": "./worker/index.mjs",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/openaimcpssubmission.mp4"]
  },
  "r2_buckets": [
    {
      "binding": "PROMPTBANKEN_MEDIA",
      "bucket_name": "promptbanken-media-dev"
    }
  ]
}
